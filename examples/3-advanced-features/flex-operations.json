    {
        "id": "format-flex-write",
        "type": "function",
        "z": "example-flex-ops",
        "name": "Format Write Result",
        "func": "// Format the flexible write result\nmsg.payload = {\n    operation: 'Flexible Write',\n    success: true,\n    unitId: msg.modbusRequest?.unitid || 1,\n    address: msg.modbusRequest?.address || 0,\n    valuesWritten: msg.modbusRequest?.value?.length || 0,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 240,
        "wires": [["display-flex-write"]]
