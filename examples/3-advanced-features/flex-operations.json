    {
        "id": "prepare-custom-fc",
        "type": "function",
        "z": "example-flex-ops",
        "name": "Prepare Custom FC",
        "func": "// Example: Read Device Identification (FC 43)\n// This is a custom Modbus function code\nmsg.payload = {\n    fc: 43,  // Read Device Identification\n    unitid: 1,\n    address: 0,\n    quantity: 1,\n    // Custom data for FC 43\n    mei: 14,  // MEI type\n    id: 0,    // Device ID code\n    objects: 3 // Number of objects\n};\n\nmsg.topic = 'custom/fc43';\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 360,
        "wires": [["flex-fc-example"]]
    },
