    {
        "id": "prepare-flex-write",
        "type": "function",
        "z": "example-flex-ops",
        "name": "Prepare Dynamic Write",
        "func": "// Dynamically configure write operation\nlet config = {\n    fc: 16,  // Function Code 16: Write Multiple Registers\n    unitid: msg.unitid || 1,\n    address: msg.address || 0,\n    value: msg.payload  // Array of values to write\n};\n\nmsg.payload = config;\nmsg.topic = 'dynamic/write';\n\nnode.status({fill:\"green\", shape:\"dot\", text:`Write addr:${config.address} values:${config.value.length}`});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 240,
        "wires": [["flex-write"]]
    },
    {
        "id": "flex-write",
        "type": "modbus-flex-write",
        "z": "example-flex-ops",
        "name": "Flex Write",
        "showStatusActivities": true,
        "showErrors": true,
        "showWarnings": true,
        "server": "modbus-client-flex",
        "emptyMsgOnFail": false,
        "keepMsgProperties": false,
        "delayOnStart": false,
        "startDelayTime": "",
        "x": 580,
