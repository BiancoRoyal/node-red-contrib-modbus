[
    {
        "id": "example-flex-ops",
        "type": "tab",
        "label": "Flex Operations",
        "disabled": false,
        "info": "# Flexible Modbus Operations\n\nThis example demonstrates dynamic Modbus operations using flex nodes:\n- **Flex Getter**: Dynamic read operations\n- **Flex Write**: Dynamic write operations\n- **Flex Connector**: Dynamic connection management\n- **Flex FC**: Custom function codes\n\n## Use Cases:\n- Dynamic addressing based on input\n- Runtime configuration changes\n- Multi-device communication\n- Custom Modbus operations"
    },
    {
        "id": "modbus-client-flex",
        "type": "modbus-client",
        "name": "Modbus Flex Server",
        "clienttype": "tcp",
        "bufferCommands": true,
        "stateLogEnabled": false,
        "queueLogEnabled": false,
        "failureLogEnabled": false,
        "tcpHost": "127.0.0.1",
        "tcpPort": "502",
        "tcpType": "DEFAULT",
        "serialPort": "/dev/ttyUSB",
        "serialType": "RTU-BUFFERED",
        "serialBaudrate": "9600",
        "serialDatabits": "8",
        "serialStopbits": "1",
        "serialParity": "none",
        "serialConnectionDelay": "100",
        "serialAsciiResponseStartDelimiter": "0x3A",
        "unit_id": "1",
        "commandDelay": "1",
        "clientTimeout": "1000",
        "reconnectOnTimeout": true,
        "reconnectTimeout": "2000",
        "parallelUnitIdsAllowed": true
    },
    {
        "id": "prepare-flex-read",
        "type": "function",
        "z": "example-flex-ops",
        "name": "Prepare Dynamic Read",
        "func": "// Dynamically configure read operation\nlet config = {\n    fc: 3,  // Function Code 3: Read Holding Registers\n    unitid: msg.unitid || 1,\n    address: msg.address || 0,\n    quantity: msg.quantity || 10\n};\n\nmsg.payload = config;\nmsg.topic = 'dynamic/read';\n\nnode.status({fill:\"blue\", shape:\"dot\", text:`Read addr:${config.address} qty:${config.quantity}`});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 120,
        "wires": [["flex-getter"]]
    },
    {
        "id": "flex-getter",
        "type": "modbus-flex-getter",
        "z": "example-flex-ops",
        "name": "Flex Read",
        "showStatusActivities": true,
        "showErrors": true,
        "showWarnings": true,
        "logIOActivities": false,
        "server": "modbus-client-flex",
        "useIOFile": false,
        "ioFile": "",
        "useIOForPayload": false,
        "emptyMsgOnFail": false,
        "keepMsgProperties": false,
        "delayOnStart": false,
        "startDelayTime": "",
        "x": 580,
        "y": 120,
        "wires": [
            ["format-flex-read"],
            []
        ]
    },
    {
        "id": "format-flex-read",
        "type": "function",
        "z": "example-flex-ops",
        "name": "Format Read Result",
        "func": "// Format the flexible read result\nif (msg.payload && Array.isArray(msg.payload)) {\n    msg.payload = {\n        operation: 'Flexible Read',\n        unitId: msg.modbusRequest?.unitid || 1,\n        address: msg.modbusRequest?.address || 0,\n        quantity: msg.modbusRequest?.quantity || msg.payload.length,\n        values: msg.payload,\n        timestamp: new Date().toISOString()\n    };\n    \n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 120,
        "wires": [["display-flex-read"]]
    },
    {
        "id": "display-flex-read",
        "type": "debug",
        "z": "example-flex-ops",
        "name": "Flex Read Result",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload.operation",
        "statusType": "msg",
        "x": 980,
        "y": 120
    },
