[
    {
        "id": "example-simple-write",
        "type": "tab",
        "label": "Simple Modbus Write",
        "disabled": false,
        "info": "# Simple Modbus Write Example\n\nThis example shows how to write values to a Modbus device.\n\n## What it does:\n- Connects to a Modbus TCP server\n- Writes a single value to a holding register\n- Confirms the write operation\n\n## Setup:\n1. Configure the Modbus server address\n2. Deploy the flow\n3. Click the inject button to write a value\n4. Check the debug panel for confirmation\n\n## Try:\n- Change the value in the inject node\n- Modify the register address\n- Write multiple registers at once"
    },
    {
        "id": "modbus-client-write",
        "type": "modbus-client",
        "name": "Modbus Server",
        "clienttype": "tcp",
        "bufferCommands": true,
        "stateLogEnabled": false,
        "queueLogEnabled": false,
        "failureLogEnabled": false,
        "tcpHost": "127.0.0.1",
        "tcpPort": "502",
        "tcpType": "DEFAULT",
        "serialPort": "/dev/ttyUSB",
        "serialType": "RTU-BUFFERED",
        "serialBaudrate": "9600",
        "serialDatabits": "8",
        "serialStopbits": "1",
        "serialParity": "none",
        "serialConnectionDelay": "100",
        "serialAsciiResponseStartDelimiter": "0x3A",
        "unit_id": "1",
        "commandDelay": "1",
        "clientTimeout": "1000",
        "reconnectOnTimeout": true,
        "reconnectTimeout": "2000",
        "parallelUnitIdsAllowed": true
    },
    {
        "id": "inject-value",
        "type": "inject",
        "z": "example-simple-write",
        "name": "Write Value: 123",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "123",
        "payloadType": "num",
        "x": 160,
        "y": 180,
        "wires": [["write-register"]]
    },
    {
        "id": "write-register",
        "type": "modbus-write",
        "z": "example-simple-write",
        "name": "Write to Register 0",
        "showStatusActivities": true,
        "showErrors": true,
        "showWarnings": true,
        "unitid": "1",
        "dataType": "HoldingRegister",
        "adr": "0",
        "quantity": "1",
        "server": "modbus-client-write",
        "emptyMsgOnFail": false,
        "keepMsgProperties": false,
        "delayOnStart": false,
        "startDelayTime": "",
        "x": 390,
        "y": 180,
        "wires": [
            ["write-success", "format-confirmation"],
            ["write-complete"]
        ]
    },
    {
        "id": "write-success",
        "type": "debug",
        "z": "example-simple-write",
        "name": "Write Response",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "auto",
        "x": 640,
        "y": 140
    },
    {
        "id": "write-complete",
        "type": "debug",
        "z": "example-simple-write",
        "name": "Complete Message",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "x": 650,
        "y": 220
    },
    {
        "id": "format-confirmation",
        "type": "function",
        "z": "example-simple-write",
        "name": "Format Confirmation",
        "func": "// Create a user-friendly confirmation message\nmsg.payload = {\n    success: true,\n    operation: 'Write',\n    register: 0,\n    value: msg.payload,\n    timestamp: new Date().toISOString(),\n    message: `Successfully wrote value ${msg.payload} to register 0`\n};\n\nmsg.topic = 'modbus/write/confirmation';\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 180,
        "wires": [["formatted-confirmation"]]
    },
    {
        "id": "formatted-confirmation",
        "type": "debug",
        "z": "example-simple-write",
        "name": "Formatted Confirmation",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 870,
        "y": 180
    },
    {
        "id": "inject-array",
        "type": "inject",
        "z": "example-simple-write",
        "name": "Write Array: [10,20,30]",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "[10,20,30]",
        "payloadType": "json",
        "x": 180,
        "y": 280,
        "wires": [["write-multiple"]]
    },
    {
        "id": "write-multiple",
        "type": "modbus-write",
        "z": "example-simple-write",
        "name": "Write Multiple Registers",
        "showStatusActivities": true,
        "showErrors": true,
        "showWarnings": true,
        "unitid": "1",
        "dataType": "HoldingRegister",
        "adr": "10",
        "quantity": "3",
        "server": "modbus-client-write",
        "emptyMsgOnFail": false,
        "keepMsgProperties": false,
        "delayOnStart": false,
        "startDelayTime": "",
        "x": 410,
        "y": 280,
        "wires": [
            ["multiple-success"],
            []
        ]
    },
    {
        "id": "multiple-success",
        "type": "debug",
        "z": "example-simple-write",
        "name": "Multiple Write Result",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "auto",
        "x": 660,
        "y": 280
    },
    {
        "id": "comment-tips",
        "type": "comment",
        "z": "example-simple-write",
        "name": "Writing Tips",
        "info": "## Tips for Writing:\n\n1. **Single Value**: Send a number to write one register\n2. **Multiple Values**: Send an array [1,2,3] to write consecutive registers\n3. **Coils**: Change dataType to 'Coil' to write digital outputs\n4. **Error Handling**: Second output shows complete message with any errors",
        "x": 130,
        "y": 80
    }
]