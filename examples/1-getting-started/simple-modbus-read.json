[
    {
        "id": "example-simple-read",
        "type": "tab",
        "label": "Simple Modbus Read",
        "disabled": false,
        "info": "# Simple Modbus Read Example\n\nThis example demonstrates the basics of reading data from a Modbus device.\n\n## What it does:\n- Connects to a Modbus TCP server\n- Reads 10 holding registers starting at address 0\n- Displays the values in the debug panel\n\n## Setup:\n1. Configure the Modbus server address in the client node\n2. Deploy the flow\n3. Watch the debug panel for register values\n\n## Learn more:\nThis is a great starting point for understanding Modbus communication in Node-RED."
    },
    {
        "id": "modbus-client-simple",
        "type": "modbus-client",
        "name": "Modbus Server",
        "clienttype": "tcp",
        "bufferCommands": true,
        "stateLogEnabled": false,
        "queueLogEnabled": false,
        "failureLogEnabled": false,
        "tcpHost": "127.0.0.1",
        "tcpPort": "502",
        "tcpType": "DEFAULT",
        "serialPort": "/dev/ttyUSB",
        "serialType": "RTU-BUFFERED",
        "serialBaudrate": "9600",
        "serialDatabits": "8",
        "serialStopbits": "1",
        "serialParity": "none",
        "serialConnectionDelay": "100",
        "serialAsciiResponseStartDelimiter": "0x3A",
        "unit_id": "1",
        "commandDelay": "1",
        "clientTimeout": "1000",
        "reconnectOnTimeout": true,
        "reconnectTimeout": "2000",
        "parallelUnitIdsAllowed": true
    },
    {
        "id": "read-registers",
        "type": "modbus-read",
        "z": "example-simple-read",
        "name": "Read Holding Registers",
        "topic": "",
        "showStatusActivities": true,
        "logIOActivities": false,
        "showErrors": true,
        "showWarnings": true,
        "unitid": "1",
        "dataType": "HoldingRegister",
        "adr": "0",
        "quantity": "10",
        "rate": "5",
        "rateUnit": "s",
        "delayOnStart": false,
        "startDelayTime": "",
        "server": "modbus-client-simple",
        "useIOFile": false,
        "ioFile": "",
        "useIOForPayload": false,
        "emptyMsgOnFail": false,
        "x": 350,
        "y": 180,
        "wires": [
            ["display-values", "format-output"],
            []
        ]
    },
    {
        "id": "display-values",
        "type": "debug",
        "z": "example-simple-read",
        "name": "Raw Values",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload.length",
        "statusType": "msg",
        "x": 610,
        "y": 140
    },
    {
        "id": "format-output",
        "type": "function",
        "z": "example-simple-read",
        "name": "Format Output",
        "func": "// Format the Modbus data for easier reading\nif (msg.payload && Array.isArray(msg.payload)) {\n    let formatted = {\n        timestamp: new Date().toISOString(),\n        registerCount: msg.payload.length,\n        values: {}\n    };\n    \n    // Create named registers for easier understanding\n    msg.payload.forEach((value, index) => {\n        formatted.values[`Register_${index}`] = value;\n    });\n    \n    msg.payload = formatted;\n    msg.topic = 'modbus/data';\n    \n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 220,
        "wires": [["formatted-output"]]
    },
    {
        "id": "formatted-output",
        "type": "debug",
        "z": "example-simple-read",
        "name": "Formatted Output",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 810,
        "y": 220
    },
    {
        "id": "comment-setup",
        "type": "comment",
        "z": "example-simple-read",
        "name": "Setup Instructions",
        "info": "1. Double-click the 'Read Holding Registers' node\n2. Click the pencil icon next to 'Server'\n3. Change the TCP Host to your Modbus server IP\n4. Update the Port if different from 502\n5. Click Update and Done\n6. Deploy the flow",
        "x": 150,
        "y": 80
    },
    {
        "id": "trigger-read",
        "type": "inject",
        "z": "example-simple-read",
        "name": "Manual Read",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "true",
        "payloadType": "bool",
        "x": 130,
        "y": 180,
        "wires": [["read-registers"]]
    }
]