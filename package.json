{
  "name": "@plus4nodered/node-red-contrib-modbus",
  "version": "6.0.0-alpha.1",
  "private": true,
  "description": "Modbus TCP, TLS, UDP and Serial client nodes for Node-RED. For server nodes, install @plus4nodered/node-red-contrib-modbus-server.",
  "dependencies": {
    "@openp4nr/node-modbus": "/Users/biancode/Development/P4NR/modbus/node-modbus-serial",
    "@xstate/fsm": "~2.1.0",
    "bson": "~6.10.1",
    "line-by-line": "~0.1.6",
    "node-forge": "~1.3.1",
    "source-map-support": "~0.5.21",
    "underscore": "~1.13.7",
    "winston": "~3.17.0"
  },
  "optionalDependencies": {
    "@serialport/list": "~12.0.0",
    "serialport": "~12.0.0"
  },
  "keywords": [
    "node-red",
    "plusfornodered",
    "modbus",
    "automation",
    "biancoroyal"
  ],
  "engines": {
    "node": ">=18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biancoroyal/node-red-contrib-modbus.git"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "Modbus-Client": "modbus/modbus-client.js",
      "Modbus-Client-TLS": "modbus/modbus-client-tls.js",
      "Modbus-Response": "modbus/modbus-response.js",
      "Modbus-Read": "modbus/modbus-read.js",
      "Modbus-Getter": "modbus/modbus-getter.js",
      "Modbus-Flex-Getter": "modbus/modbus-flex-getter.js",
      "Modbus-Write": "modbus/modbus-write.js",
      "Modbus-Flex-Write": "modbus/modbus-flex-write.js",
      "Modbus-Queue-Info": "modbus/modbus-queue-info.js",
      "Modbus-Flex-Connector": "modbus/modbus-flex-connector.js",
      "Modbus-IO-Config": "modbus/modbus-io-config.js",
      "Modbus-Response-Filter": "modbus/modbus-response-filter.js",
      "Modbus-Flex-Sequencer": "modbus/modbus-flex-sequencer.js",
      "Modbus-Flex-Fc": "modbus/modbus-flex-fc.js"
    }
  },
  "author": "Klaus Landsdorf <klaus.landsdorf@bianco-royal.de>",
  "license": "BSD-3-Clause",
  "main": "node",
  "files": [
    "docs",
    "examples",
    "modbus",
    "extras"
  ],
  "bugs": {
    "url": "https://github.com/biancoroyal/node-red-contrib-modbus/issues/"
  },
  "homepage": "https://plus4nodered.com/",
  "scripts": {
    "prereq": "npm run lint",
    "lint": "standard --fix",
    "clean": "gulp clean && npm run lint",
    "build": "npm run lint && gulp",
    "changelog": "gulp changelog",
    "test": "npm run prereq && mocha --exit",
    "test:watch": "mocha test/**/*.js --recursive --watch",
    "test:slow": "npm run prereq && mocha test/**/*.js --recursive --exit --timeout 30000",
    "test:verbose": "npm run prereq && mocha test/**/*.js --recursive --exit --reporter spec",
    "test:withStop": "npm run prereq && mocha test/**/*.js --recursive --exit --bail",
    "test:publish": "npm run clean && npm run prepublishOnly",
    "test:e2e": "npm run prereq && mocha test/e2e/*.js --recursive --exit --timeout 30000",
    "test:units": "npm run prereq && mocha test/units/*.js --recursive --exit",
    "test:core": "npm run prereq && mocha test/core/*.js --recursive --exit",
    "test:integration": "mocha --config .mocharc.integration.json",
    "test:parallel": "npm run test",
    "ci:quality-gate": "npm run lint && npm run build",
    "test:migration:cleanup": "find test -name '*-test.js' -delete",
    "coverage": "npm run prereq && nyc mocha test/**/*.js --recursive --exit",
    "coverage:codacy": "nyc --reporter=lcovonly mocha test/**/*.js --recursive --exit && cat ./coverage/lcov.info | codacy-coverage --token $CODACY_COVERAGE_TOKEN && rm -rf ./coverage",
    "coverage:coveralls": "npm run lint && nyc --reporter=text-lcov mocha test/**/*.js --recursive --exit | coveralls",
    "prepublishOnly": "npm run clean && npm run changelog && npm test && npm run coverage && npm run build",
    "ci-publish": "ci-publish",
    "release": "standard-version -a",
    "release:beta": "standard-version --prerelease beta",
    "release:alpha": "standard-version --prerelease alpha",
    "dev:link": "npm i && npm run build && npm link",
    "dev:unlink": "npm unlink @plus4nodered/node-red-contrib-modbus -g",
    "dev:link-local": "npm run build && npm link",
    "node-red": "npm run build && cd .node-red-test && npx node-red -u .",
    "node-red:debug": "npm run build && cd .node-red-test && DEBUG=contribModbus* npx node-red -u .",
    "node-red:init": "./scripts/setup-node-red-test.sh",
    "node-red:clean": "rm -rf .node-red-test",
    "node-red:start": "npm run node-red:init && npm run node-red",
    "node-red:update": "npm run build && cd .node-red-test && npm update @plus4nodered/node-red-contrib-modbus",
    "node-red:watch": "npm run build && nodemon --watch src --exec 'npm run build && npm run node-red:update && cd .node-red-test && npx node-red -u .'"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.5",
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@babel/register": "^7.24.5",
    "@node-red/nodes": "^5.0.0",
    "@plus4nodered/node-red-contrib-modbus-server": "file:../node-red-contrib-modbus-server",
    "address": "^2.0.1",
    "chai": "^3.5.0",
    "codacy-coverage": "^3.4.0",
    "conventional-changelog-cli": "^5.0.0",
    "coveralls": "^3.1.1",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-clean": "^0.4.0",
    "gulp-conventional-changelog": "^5.0.0",
    "gulp-htmlmin": "^5.0.1",
    "gulp-jsdoc3": "^3.0.0",
    "gulp-replace": "^1.1.4",
    "gulp-sequence": "^1.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "jasmine-node": "^3.0.0",
    "js-beautify": "^1.15.1",
    "mocha": "^10.4.0",
    "nock": "^13.5.4",
    "node-red": "^5.0.0",
    "node-red-node-test-helper": "/Users/biancode/Development/P4NR/Node-RED/node-red-node-test-helper",
    "nodemon": "^3.0.0",
    "nyc": "^15.1.0",
    "pump": "^3.0.0",
    "should": "^13.2.3",
    "sinon": "^17.0.1",
    "standard": "^17.1.0",
    "standard-version": "^9.5.0",
    "supertest": "^7.0.0",
    "uglify-js": "^3.17.4",
    "uglify-js-harmony": "^2.7.7",
    "when": "^3.7.8"
  },
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "standard": {
    "env": [
      "mocha"
    ],
    "globals": [
      "describe",
      "it",
      "before",
      "after",
      "beforeEach",
      "afterEach"
    ],
    "ignore": [
      "code/",
      "coverage/",
      "node_modules/",
      "examples/",
      "modbus/",
      "docs",
      "extras",
      "test/resources/**",
      "test/e2e/flows/**",
      "test/integrations/flows/**",
      "test/units/flows/**",
      "__tests__/units/flows/**",
      "__tests__/units/**",
      ".node-red-test"
    ]
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/node-red-contrib-modbus"
  }
}
