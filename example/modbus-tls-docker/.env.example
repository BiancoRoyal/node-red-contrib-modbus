# Docker Compose Environment Variables for Modbus TLS Testing

# Node-RED Configuration
NODE_RED_VERSION=latest
NODE_RED_CREDENTIAL_SECRET=your-secret-key-here
TZ=UTC

# Modbus TLS Ports
MODBUS_TLS_PORT=8502
MODBUS_TCP_PORT=5020

# Node-RED UI Ports
SERVER_UI_PORT=1880
CLIENT_UI_PORT=1881

# Debug Settings
DEBUG_LEVEL=contribModbus*

# Certificate Validity (days)
CERT_VALIDITY_DAYS=3650

# Network Configuration
NETWORK_SUBNET=172.30.0.0/16